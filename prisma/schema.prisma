generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Author {
  id        Int     @id @default(autoincrement())
  name      String
  bio       String?
  avatarUrl String?
  posts     Post[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id                           Int         @id @default(autoincrement())
  title                        String
  slug                         String      @unique
  badge                        String?
  excerpt                      String?
  content                      String
  imageUrl                     String?
  facebookUrl                  String?
  linkedinUrl                  String?
  twitterUrl                   String?
  youtubeUrl                   String?
  email                        String?
  whatsappNumber               String?
  authorId                     Int?
  companyId                    Int?
  categoryId                   Int
  status                       Post_status @default(PENDING)
  createdById                  Int?
  approvedById                 Int?
  approvedAt                   DateTime?
  publishedAt                  DateTime?
  views                        Int         @default(0)
  shares                       Int         @default(0)
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt
  comments                     Comment[]
  User_Post_approvedByIdToUser User?       @relation("Post_approvedByIdToUser", fields: [approvedById], references: [id])
  author                       Author?     @relation(fields: [authorId], references: [id])
  category                     Category    @relation(fields: [categoryId], references: [id])
  Company                      Company?    @relation(fields: [companyId], references: [id])
  User_Post_createdByIdToUser  User?       @relation("Post_createdByIdToUser", fields: [createdById], references: [id])

  @@index([approvedById])
  @@index([authorId])
  @@index([categoryId])
  @@index([companyId])
  @@index([createdById])
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  name      String
  email     String?
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])

  @@index([postId])
}

model User {
  id                                                      Int                      @id @default(autoincrement())
  email                                                   String                   @unique
  mobile                                                  String?                  @unique
  password                                                String
  role                                                    String                   @default("candidate")
  emailVerified                                           Boolean                  @default(false)
  mobileVerified                                          Boolean                  @default(false)
  otpHash                                                 String?
  otpExpiry                                               DateTime?
  mobileOtpHash                                           String?
  mobileOtpExpiry                                         DateTime?
  resetOtpHash                                            String?
  resetOtpExpiry                                          DateTime?
  failedLoginAttempts                                     Int                      @default(0)
  lockUntil                                               DateTime?
  createdAt                                               DateTime                 @default(now())
  username                                                String                   @unique
  fullName                                                String?
  headline                                                String?
  about                                                   String?
  location                                                String?
  avatarUrl                                               String?
  websiteUrl                                              String?
  isOnboarded                                             Boolean                  @default(false)
  companyId                                               Int?
  packageSelected                                         Boolean                  @default(false)
  emailSentForBulkImport                                  Boolean                  @default(false)
  lastLoginAt                                             DateTime?
  isActive                                                Boolean                  @default(true)
  roleId                                                  Int?
  
  // Relations
  AdvertisementBanner                                     AdvertisementBanner[]
  achievements                                            CandidateAchievement[]
  certifications                                          CandidateCertification[]
  education                                               CandidateEducation[]
  experiences                                             CandidateExperience[]
  interests                                               CandidateInterest[]
  languages                                               CandidateLanguage[]
  projects                                                CandidateProject[]
  skills                                                  CandidateSkill[]
  socials                                                 CandidateSocial[]
  CompanyFollower                                         CompanyFollower[]
  approvedTeamMembers                                     CompanyTeamMember[]      @relation("TeamMemberApprovedBy")
  teamMemberships                                         CompanyTeamMember[]      @relation("TeamMemberUser")
  Event_Event_approvedByIdToUser                          Event[]                  @relation("Event_approvedByIdToUser")
  Event_Event_createdByIdToUser                           Event[]                  @relation("Event_createdByIdToUser")
  Job                                                     Job[]
  JobAlert                                                JobAlert[]
  JobApplication                                          JobApplication[]
  Magazine                                                Magazine[]
  NewsletterCampaign                                      NewsletterCampaign[]
  NewsletterSubscriber                                    NewsletterSubscriber[]
  NewsletterTemplate                                      NewsletterTemplate[]
  PackagePurchase                                         PackagePurchase[]
  Post_Post_approvedByIdToUser                            Post[]                   @relation("Post_approvedByIdToUser")
  Post_Post_createdByIdToUser                             Post[]                   @relation("Post_createdByIdToUser")
  SavedJob                                                SavedJob[]
  SupplierDirectory_SupplierDirectory_approvedByIdToUser  SupplierDirectory[]      @relation("SupplierDirectory_approvedByIdToUser")
  SupplierDirectory_SupplierDirectory_submittedByIdToUser SupplierDirectory[]      @relation("SupplierDirectory_submittedByIdToUser")
  Company                                                 Company?                 @relation(fields: [companyId], references: [id])
  roleTemplate                                            Role?                    @relation(fields: [roleId], references: [id])
  grantedPermissions                                      UserPermission[]         @relation("PermissionGrantedBy")
  userPermissions                                         UserPermission[]         @relation("UserPermissions")
  resume                                                  CandidateResume?
  
  // Connection Relations
  receivedConnectionRequests                              ConnectionRequest[]      @relation("ConnectionRequestReceiver")
  sentConnectionRequests                                  ConnectionRequest[]      @relation("ConnectionRequestSender")
  connections                                             UserConnection[]         @relation("UserConnections")
  connectedTo                                             UserConnection[]         @relation("ConnectedUsers")

  industryTalksCreated  IndustryTalk[] @relation("IndustryTalkCreatedBy")
  industryTalksApproved IndustryTalk[] @relation("IndustryTalkApprovedBy")

  @@index([companyId])
}

model CandidateResume {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConnectionRequest {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  status      ConnectionRequestStatus @default(PENDING)
  message     String?
  acceptedAt  DateTime?
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sender      User     @relation("ConnectionRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ConnectionRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model UserConnection {
  id           Int      @id @default(autoincrement())
  userId       Int
  connectionId Int
  createdAt    DateTime @default(now())
  user         User     @relation("UserConnections", fields: [userId], references: [id], onDelete: Cascade)
  connection   User     @relation("ConnectedUsers", fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, connectionId])
  @@index([userId])
  @@index([connectionId])
}

model CandidateSkill {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  level     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateExperience {
  id               Int       @id @default(autoincrement())
  userId           Int
  companyId        Int?
  companyName      String
  designation      String
  employmentType   String?
  location         String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean   @default(false)
  description      String?
  company          Company?  @relation(fields: [companyId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model CandidateEducation {
  id           Int     @id @default(autoincrement())
  userId       Int
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  grade        String?
  description  String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateProject {
  id           Int       @id @default(autoincrement())
  userId       Int
  title        String
  role         String?
  description  String?
  imageUrl     String?
  websiteUrl   String?
  githubUrl    String?
  technologies Json?
  startDate    DateTime?
  endDate      DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateCertification {
  id            Int       @id @default(autoincrement())
  userId        Int
  title         String
  organization  String?
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialUrl String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateLanguage {
  id          Int    @id @default(autoincrement())
  userId      Int
  language    String
  proficiency String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateSocial {
  id       Int    @id @default(autoincrement())
  userId   Int
  platform String
  url      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateInterest {
  id     Int     @id @default(autoincrement())
  userId Int
  title  String
  type   String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateAchievement {
  id              Int       @id @default(autoincrement())
  userId          Int
  title           String
  organization    String?
  description     String?
  achievementDate DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdvertisementBanner {
  id          Int                           @id @default(autoincrement())
  title       String
  imageUrl    String
  targetUrl   String?
  placement   AdvertisementBanner_placement
  status      AdvertisementBanner_status    @default(INACTIVE)
  position    Int                           @default(0)
  startDate   DateTime?
  endDate     DateTime?
  impressions Int                           @default(0)
  clicks      Int                           @default(0)
  createdById Int
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime
  User        User                          @relation(fields: [createdById], references: [id])

  @@index([createdById])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int?
  userId    Int?
  createdAt DateTime @default(now())
}

model Company {
  id                    Int                    @id @default(autoincrement())
  name                  String
  slug                  String                 @unique
  tagline               String?
  description           String?
  location              String?
  companySize           String?
  website               String?
  logoUrl               String?
  coverImageUrl         String?
  isVerified            Boolean                @default(false)
  createdAt             DateTime               @default(now())
  industryId            Int?
  address               String?
  subscriptionPlan      String                 @default("free")
  subscriptionExpiresAt DateTime?
  jobPostingCredits     Int                    @default(0)
  candidateExperiences  CandidateExperience[]
  Industry              Industry?              @relation(fields: [industryId], references: [id])
  CompanyFollower       CompanyFollower[]
  teamMembers           CompanyTeamMember[]
  Job                   Job[]
  NewsletterSubscriber  NewsletterSubscriber[]
  PackagePurchase       PackagePurchase[]
  Post                  Post[]
  SupplierDirectory     SupplierDirectory[]
  User                  User[]

  @@index([industryId])
}

model CompanyTeamMember {
  id              Int              @id @default(autoincrement())
  companyId       Int
  userId          Int
  designation     String
  department      String?
  employmentType  String?
  startDate       DateTime?
  endDate         DateTime?
  status          TeamMemberStatus @default(PENDING)
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  approvedBy      User?            @relation("TeamMemberApprovedBy", fields: [approvedById], references: [id])
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User             @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([status])
}

model PackagePurchase {
  id                Int                    @id @default(autoincrement())
  userId            Int
  companyId         Int?
  packageType       PackagePurchase_type
  packageId         String
  packageName       String
  amount            Int
  currency          String                 @default("INR")
  status            PackagePurchase_status @default(PENDING)
  razorpayOrderId   String?                @unique
  razorpayPaymentId String?
  metadata          Json?
  startsAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  Company           Company?               @relation(fields: [companyId], references: [id])
  User              User                   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([packageType])
}

model CompanyFollower {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int
  createdAt DateTime @default(now())
  Company   Company  @relation(fields: [companyId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
}

model CoverStory {
  id               Int             @id @default(autoincrement())
  title            String
  slug             String          @unique
  shortDescription String?
  keyCategories    Json?
  imageBrief       String?
  fullDescription  String
  badge            String?
  coverImageUrl    String?
  slugImageUrls    Json?
  createdAt        DateTime        @default(now())
  authorId         Int?
  MagazineAuthor   MagazineAuthor? @relation(fields: [authorId], references: [id])
  Magazine         Magazine[]

  @@index([authorId])
}

model IndustryTalk {
  id Int @id @default(autoincrement())

  title String
  slug  String @unique

  interviewType String?
  categoryId Int?
  industryId Int?

  status Event_status @default(DRAFT)

  featured Boolean @default(false)
  trending Boolean @default(false)
  homepage Boolean @default(false)

  bannerImage String?

  videoType String?
  videoUrl String?
  uploadedVideo String?
  thumbnailUrl String?
  duration Int?

  guestName String
  designation String?
  companyName String?
  companyLogo String?
  website String?
  linkedinUrl String?
  profileImage String?
  shortBio String? @db.Text

  introduction String? @db.Text

  seoTitle String?
  seoDescription String? @db.Text
  seoKeywords Json?

  relatedInterviews Json?

  views Int @default(0)
  shares Int @default(0)

  createdById Int
  approvedById Int?

  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("IndustryTalkCreatedBy", fields: [createdById], references: [id])
  approvedBy User? @relation("IndustryTalkApprovedBy", fields: [approvedById], references: [id])

  questions IndustryTalkQuestion[]
  quotes IndustryTalkQuote[]
  gallery IndustryTalkGallery[]
  documents IndustryTalkDocument[]

  @@index([slug])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}

model IndustryTalkQuestion {
  id Int @id @default(autoincrement())

  industryTalkId Int

  question String
  answer String @db.Text

  videoTimestamp String?
  highlightQuote String?

  displayOrder Int @default(0)

  industryTalk IndustryTalk @relation(fields: [industryTalkId], references: [id], onDelete: Cascade)

  @@index([industryTalkId])
}

model IndustryTalkQuote {
  id Int @id @default(autoincrement())

  industryTalkId Int

  quote String

  displayOrder Int @default(0)

  industryTalk IndustryTalk @relation(fields: [industryTalkId], references: [id], onDelete: Cascade)

  @@index([industryTalkId])
}

model IndustryTalkGallery {
  id Int @id @default(autoincrement())

  industryTalkId Int

  imageUrl String
  caption String?

  displayOrder Int @default(0)

  industryTalk IndustryTalk @relation(fields: [industryTalkId], references: [id], onDelete: Cascade)

  @@index([industryTalkId])
}

model IndustryTalkDocument {
  id Int @id @default(autoincrement())

  industryTalkId Int

  title String
  fileUrl String
  fileSize String?

  displayOrder Int @default(0)

  industryTalk IndustryTalk @relation(fields: [industryTalkId], references: [id], onDelete: Cascade)

  @@index([industryTalkId])
}

model Event {
  id                            Int                 @id @default(autoincrement())
  title                         String
  slug                          String              @unique
  logoUrl                       String?
  bannerUrl                     String?
  startDate                     DateTime
  endDate                       DateTime
  description                   String
  websiteUrl                    String?
  registerUrl                   String?
  location                      String?
  calendarUrl                   String?
  status                        Event_status        @default(DRAFT)
  views                         Int                 @default(0)
  createdById                   Int
  approvedById                  Int?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime
  publishedAt                   DateTime?
  address                       String?
  brochureUrl                   String?
  city                          String?
  contactPerson                 String?
  country                       String?
  eventType                     String?
  facebookUrl                   String?
  highlights                    Json?
  linkedinUrl                   String?
  organizationName              String?
  organizerEmail                String?
  organizerMobile               String?
  organizerPhone                String?
  otherImages                   Json?
  rejectionReason               String?
  shortDescription              String?
  timings                       String?
  twitterUrl                    String?
  youtubeUrl                    String?
  organizationWebsite           String?
  videoGallery                  Json?
  User_Event_approvedByIdToUser User?               @relation("Event_approvedByIdToUser", fields: [approvedById], references: [id])
  User_Event_createdByIdToUser  User                @relation("Event_createdByIdToUser", fields: [createdById], references: [id])
  EventEnquiry                  EventEnquiry[]
  EventRegistration             EventRegistration[]

  @@index([approvedById])
  @@index([createdById])
  @@index([status])
}

model EventRegistration {
  id                  Int      @id @default(autoincrement())
  eventId             Int
  fullName            String
  email               String
  phone               String
  companyName         String?
  jobTitle            String?
  country             String?
  city                String?
  industry            String?
  experience          String?
  attendeeType        String?
  ticketType          String?
  interests           Json?
  specialRequirements String?
  status              String   @default("REGISTERED")
  createdAt           DateTime @default(now())
  Event               Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

model EventEnquiry {
  id        Int      @id @default(autoincrement())
  eventId   Int
  name      String
  email     String
  mobile    String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  Event     Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

model Industry {
  id             Int        @id @default(autoincrement())
  name           String
  slug           String     @unique
  parentId       Int?
  createdAt      DateTime   @default(now())
  Company        Company[]
  Industry       Industry?  @relation("IndustryToIndustry", fields: [parentId], references: [id])
  other_Industry Industry[] @relation("IndustryToIndustry")

  @@index([parentId])
}

model Job {
  id                  Int              @id @default(autoincrement())
  title               String
  slug                String           @unique
  description         String
  employmentType      String
  experience          String?
  location            String
  isRemote            Boolean          @default(false)
  isActive            Boolean          @default(true)
  views               Int              @default(0)
  companyId           Int?
  postedById          Int
  createdAt           DateTime         @default(now())
  applyUrl            String?
  isExternal          Boolean          @default(false)
  linkedinUrl         String?
  companyName         String?
  featuredAt          DateTime?
  isFeatured          Boolean          @default(false)
  aboutCompany        String?
  allowEasyApply      Boolean          @default(true)
  applicationDeadline DateTime?
  applicationsCount   Int              @default(0)
  benefits            Json?
  city                String?
  clickCount          Int              @default(0)
  companySize         String?
  companyWebsite      String?
  country             String?
  department          String?
  education           String?
  employmentMode      String?
  expectedJoiningDate DateTime?
  expiresAt           DateTime?
  industry            String?
  isHybrid            Boolean          @default(false)
  jobFunction         String?
  keywords            Json?
  languages           Json?
  maxExperience       Int?
  metaDescription     String?
  metaTitle           String?
  minExperience       Int?
  noticePeriod        String?
  openings            Int              @default(1)
  preferredSkills     Json?
  publishedAt         DateTime?
  recruiterEmail      String?
  recruiterName       String?
  recruiterPhone      String?
  referralBonus       Int?
  relocationSupport   Boolean          @default(false)
  reportsTo           String?
  requireCoverLetter  Boolean          @default(false)
  requireLinkedin     Boolean          @default(false)
  requirePortfolio    Boolean          @default(false)
  requireResume       Boolean          @default(true)
  requirements        String?
  responsibilities    String?
  salaryCurrency      String?          @default("INR")
  salaryMax           Int?
  salaryMin           Int?
  salaryPeriod        String?
  savedCount          Int              @default(0)
  seniorityLevel      String?
  shareCount          Int              @default(0)
  shift               String?
  showSalary          Boolean          @default(true)
  skills              Json?
  state               String?
  travelRequired      Boolean          @default(false)
  updatedAt           DateTime         @default(now())
  visaSponsorship     Boolean          @default(false)
  workplaceType       String?
  zipCode             String?
  Company             Company?         @relation(fields: [companyId], references: [id])
  User                User             @relation(fields: [postedById], references: [id])
  JobApplication      JobApplication[]
  SavedJob            SavedJob[]

  @@index([companyId])
  @@index([postedById])
  @@index([applicationDeadline])
  @@index([city])
  @@index([country])
  @@index([department])
  @@index([employmentType])
  @@index([industry])
  @@index([isActive])
  @@index([isFeatured])
  @@index([location])
  @@index([publishedAt])
  @@index([seniorityLevel])
  @@index([state])
  @@index([workplaceType])
}

model SavedJob {
  id        Int      @id @default(autoincrement())
  jobId     Int
  userId    Int
  createdAt DateTime @default(now())
  Job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

model JobAlert {
  id             Int      @id @default(autoincrement())
  userId         Int
  name           String?
  keywords       String?
  location       String?
  employmentType String?
  isRemote       Boolean?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JobApplication {
  id        Int      @id @default(autoincrement())
  jobId     Int
  userId    Int
  resumeUrl String?
  coverNote String?
  status    String   @default("applied")
  createdAt DateTime @default(now())
  Job       Job      @relation(fields: [jobId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
  @@index([userId])
}

model Magazine {
  id                   Int                    @id @default(autoincrement())
  title                String
  slug                 String                 @unique
  description          String?
  coverImageUrl        String?
  pdfUrl               String
  flipbookPages        Json?
  status               Magazine_status        @default(DRAFT)
  createdById          Int
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  publishedAt          DateTime?
  authorId             Int?
  coverStoryId         Int?
  MagazineAuthor       MagazineAuthor?        @relation(fields: [authorId], references: [id])
  CoverStory           CoverStory?            @relation(fields: [coverStoryId], references: [id])
  User                 User                   @relation(fields: [createdById], references: [id])
  MagazineRegistration MagazineRegistration[]

  @@index([authorId])
  @@index([coverStoryId])
  @@index([createdById])
}

model MagazineAuthor {
  id              Int          @id @default(autoincrement())
  name            String
  profileImageUrl String?
  designation     String?
  linkedinUrl     String?
  createdAt       DateTime     @default(now())
  CoverStory      CoverStory[]
  Magazine        Magazine[]
}

model MagazineRegistration {
  id          Int      @id @default(autoincrement())
  magazineId  Int
  firstName   String
  lastName    String
  email       String
  companyName String?
  jobTitle    String?
  country     String?
  createdAt   DateTime @default(now())
  Magazine    Magazine @relation(fields: [magazineId], references: [id])

  @@index([magazineId])
}

model SupplierDirectory {
  id                                         Int                      @id @default(autoincrement())
  name                                       String
  slug                                       String                   @unique
  companyId                                  Int?
  phoneNumber                                String?
  email                                      String?
  website                                    String?
  googleMapUrl                               String?
  logoUrl                                    String?
  coverImageUrl                              Json?
  description                                String
  tradeNames                                 Json?
  socialLinks                                Json?
  videoGallery                               Json?
  productSupplies                            Json?
  productGallery                             Json?
  companyGallery                             Json?
  factoryGallery                             Json?
  productCatalogues                          Json?
  companyBrochure                            Json?
  certifications                             Json?
  brandsRepresented                          Json?
  industriesServed                           Json?
  exportMarkets                              Json?
  manufacturingCapabilities                  String?
  machineryList                              String?
  qualityStandards                           String?
  enableInquiryForm                          Boolean                  @default(true)
  status                                     SupplierDirectory_status @default(PENDING)
  isLiveEditable                             Boolean                  @default(false)
  views                                      Int                      @default(0)
  connections                                Int                      @default(0)
  submittedById                              Int
  approvedById                               Int?
  createdAt                                  DateTime                 @default(now())
  approvedAt                                 DateTime?
  isFeatured                                 Boolean                  @default(false)
  machineryImages                            Json?
  manufacturingCapabilityImages              Json?
  manufacturingCapabilityVideos              Json?
  User_SupplierDirectory_approvedByIdToUser  User?                    @relation("SupplierDirectory_approvedByIdToUser", fields: [approvedById], references: [id])
  Company                                    Company?                 @relation(fields: [companyId], references: [id])
  User_SupplierDirectory_submittedByIdToUser User                     @relation("SupplierDirectory_submittedByIdToUser", fields: [submittedById], references: [id])

  @@index([approvedById])
  @@index([companyId])
  @@index([submittedById])
}

model NewsletterSubscriber {
  id                  Int                        @id @default(autoincrement())
  fullName            String?
  email               String?                    @unique
  phoneNumber         String?
  companyName         String?
  userId              Int?
  companyId           Int?
  source              NewsletterSubscriberSource
  emailSubscribed     Boolean                    @default(true)
  whatsappSubscribed  Boolean                    @default(false)
  smsSubscribed       Boolean                    @default(false)
  frequency           NewsletterFrequency        @default(MONTHLY)
  status              NewsletterStatus           @default(ACTIVE)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  NewsletterRecipient NewsletterRecipient[]
  Company             Company?                   @relation(fields: [companyId], references: [id])
  User                User?                      @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([phoneNumber])
  @@index([companyId])
  @@index([userId])
}

model NewsletterCampaign {
  id                  Int                   @id @default(autoincrement())
  title               String
  subject             String
  content             String
  coverImage          String?
  emailEnabled        Boolean               @default(true)
  whatsappEnabled     Boolean               @default(false)
  smsEnabled          Boolean               @default(false)
  frequency           NewsletterFrequency?
  scheduledAt         DateTime?
  sentAt              DateTime?
  status              CampaignStatus        @default(DRAFT)
  totalRecipients     Int                   @default(0)
  delivered           Int                   @default(0)
  opened              Int                   @default(0)
  clicked             Int                   @default(0)
  failed              Int                   @default(0)
  createdById         Int
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  User                User                  @relation(fields: [createdById], references: [id])
  NewsletterRecipient NewsletterRecipient[]

  @@index([status])
}

model NewsletterRecipient {
  id                   Int                  @id @default(autoincrement())
  campaignId           Int
  subscriberId         Int
  emailStatus          DeliveryStatus       @default(PENDING)
  whatsappStatus       DeliveryStatus       @default(PENDING)
  smsStatus            DeliveryStatus       @default(PENDING)
  sentAt               DateTime?
  openedAt             DateTime?
  clickedAt            DateTime?
  NewsletterCampaign   NewsletterCampaign   @relation(fields: [campaignId], references: [id])
  NewsletterSubscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id])

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
}

model Lead {
  id          Int         @id @default(autoincrement())
  source      Lead_source
  contactId   Int?
  supplierId  Int?
  userId      Int?
  companyId   Int?
  fullName    String
  email       String
  phoneNumber String?
  website     String?
  companyName String?
  message     String
  hasPackage  Boolean     @default(false)
  planName    String?
  status      LeadStatus  @default(NEW)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt  // ✅ Fix: Change @updatedA to @updatedAt

  @@index([contactId])
  @@index([supplierId])
  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([source])
}

model Package {
  id            String       @id @default(cuid())
  name          String
  type          PackageType
  price         Int
  billingCycle  BillingCycle
  description   String?
  badge         String?
  displayOrder  Int          @default(0)
  isHighlighted Boolean      @default(false)
  isActive      Boolean      @default(true)
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([type])
  @@index([isActive])
  @@index([displayOrder])
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String
  slug            String           @unique
  description     String?
  sortOrder       Int              @default(100)
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model NewsletterTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  subject     String
  content     String
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User     @relation(fields: [createdById], references: [id])
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  label           String?
  module          String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  grantedById  Int?
  createdAt    DateTime   @default(now())
  granted      Boolean    @default(true)
  grantedBy    User?      @relation("PermissionGrantedBy", fields: [grantedById], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([grantedById])
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String
  phoneNumber String?
  website     String?
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}

